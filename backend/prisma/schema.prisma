// ============================================================
// PRISMA SCHEMA — AI Smart Farming Assistant Database
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── User ────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  role      String   @default("user")  // "admin" | "user"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Device ──────────────────────────────────────────────────
model Device {
  id         String         @id @default(uuid())
  name       String
  ipAddress  String         @unique
  type       String
  status     String         @default("UNKNOWN")
  lastSeen   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  readings   SensorReading[]
  pumpEvents PumpEvent[]
}

// (Enums removed for SQLite compatibility)

// ── SensorReading ────────────────────────────────────────────
model SensorReading {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  soil1       Float?
  soil2       Float?
  soilAverage Float?
  temperature Float?
  humidity    Float?
  light       Float?
  waterLevel  Float?
  pumpState   Boolean  @default(false)
  mode        String   @default("AUTO")  // "AUTO" | "MANUAL"

  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id])

  @@index([timestamp])
  @@index([deviceId, timestamp])
}

// ── PumpEvent ────────────────────────────────────────────────
model PumpEvent {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  state       Boolean              // true = ON, false = OFF
  reason      String
  soilAverage Float?
  waterLevel  Float?

  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id])

  @@index([timestamp])
}

// ── Alert ────────────────────────────────────────────────────
model Alert {
  id        String        @id @default(uuid())
  timestamp DateTime      @default(now())
  type      String
  severity  String
  message   String
  language  String        @default("en")
  resolved  Boolean       @default(false)
  resolvedAt DateTime?

  @@index([timestamp])
  @@index([resolved])
}

// (Enums removed for SQLite compatibility)

// ── AIRecommendation ─────────────────────────────────────────
model AIRecommendation {
  id             String   @id @default(uuid())
  timestamp      DateTime @default(now())
  soilAverage    Float?
  temperature    Float?
  humidity       Float?
  waterLevel     Float?
  light          Float?
  soilStatus     String
  irrigation     String
  urgency        String
  recommendation String
  reason         String
  actions        String   // JSON array as string
  language       String   @default("en")

  @@index([timestamp])
}

// ── SystemSetting ────────────────────────────────────────────
model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}
