# ============================================================
# AI SMART FARMING ASSISTANT — .gitignore
# ============================================================

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.production

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
.next/

# Prisma generated client
backend/node_modules/
backend/dist/
backend/prisma/*.db
backend/prisma/*.db-journal
*.db

# Frontend build
frontend/dist/
frontend/.vite/

# TypeScript compiled output
*.js.map
*.d.ts.map

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Arduino compiled artifacts
*.elf
*.bin
*.hex
build/

# Test coverage
coverage/
.nyc_output/
